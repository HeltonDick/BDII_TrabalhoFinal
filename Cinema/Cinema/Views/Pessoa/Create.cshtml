@model Cinema.Models.Pessoa

@{
    ViewData["Title"] = "Create";
}

<h1>Criar Nova Pessoa</h1>
<hr/>

<div class="row">

    <div class="col-md-4">

        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger">
                <div class="form-group">

                    <label asp-for="PrimeiroNome">Primeiro Nome</label>
                    <input type="text" class="form-control" asp-for="PrimeiroNome" />

                    <label asp-for="UltimoNome">Ultimo Nome</label>
                    <input type="text" class="form-control" asp-for="UltimoNome" />

                    <label asp-for="DataNascimento">Data de nacimento</label>
                    <input type="date" class="form-control" asp-for="DataNascimento" />

                    <label asp-for="Cpf">CPF</label>
                    <input type="text" class="form-control" asp-for="Cpf" />

                    <label asp-for="Numero">Numero para contato</label>
                    <input type="number" class="form-control" asp-for="Numero"/>

                    <label asp-for="Sexo">Sexo</label>
                    <select asp-for="SexoId" class="form-control" asp-items="ViewBag.Sexos">
                        <option value="">Selecione o sexo</option>
                    </select>

                    <hr/>
                    <h3>Endereço</h3>

                    <label asp-for="Endereco.Rua1">Rua</label>
                    <input type="text" class="form-control" asp-for="Endereco.Rua1" />

                    <label asp-for="Endereco.Rua2">Cidade</label>
                    <input type="text" class="form-control" asp-for="Endereco.Rua2" />

                    <label asp-for="Endereco.Bairro">Bairro</label>
                    <input type="text" class="form-control" asp-for="Endereco.Bairro" />

                    <label asp-for="Endereco.Cep">CEP</label>
                    <input type="number" class="form-control" asp-for="Endereco.Cep" />

                    <label asp-for="Endereco.Logradouro">Logradouro</label>
                    <input type="text" class="form-control" asp-for="Endereco.Logradouro" />

                    <label asp-for="Endereco.Referencia">Referencia</label>
                    <input type="text" class="form-control" asp-for="Endereco.Referencia" />

                </div>
            </div>
        </form>

    </div>

</div>